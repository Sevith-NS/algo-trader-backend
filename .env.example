# Flask quant backend — copy to backend/.env and fill in.
# Loaded by ai_assistant.py, deep_analysis.py and geotrade_layer.py.

# Google Gemini — powers the AI assistant, deep analysis, geotrade narrative and
# the multi-agent trading desk (agents_desk.py).
GEMINI_API_KEY=

# Groww Trading API (https://groww.in/trade-api) — India market data.
# Reserved: nse_segments.py currently pulls the public instrument CSV and does
# not authenticate, so these are unused until a private endpoint is wired up.
GROWW_ACCESS_TOKEN=
GROWW_API_SECRET=

# Browsers allowed to call /api/* (comma-separated, exact origins — no
# wildcard). Defaults to http://localhost:3000,http://127.0.0.1:3000. Set this
# to your deployed frontend's origin; these routes have no auth, so a wildcard
# lets any site a user visits drive the API from their browser and their IP.
#   CORS_ORIGINS=https://flint.vercel.app

# Optional runtime flags, all read via os.environ in the backend:
#   TRUST_PROXY=1         honour X-Forwarded-For for rate limiting behind a proxy
#   WEB_CONCURRENCY=N     set to your server's worker count; rate_limiter.py divides
#                         each token bucket by it, since buckets are per-process
#   MAX_CONTENT_LENGTH_BYTES=1048576   request body cap (default 1 MiB)
#   FLASK_DEBUG=1         enable the Werkzeug debug console on `python app.py`.
#                         Off by default: the console runs arbitrary Python for
#                         anyone who can reach the port. Never set in a shared
#                         environment.
#   ALLOW_INSECURE_TLS=1  LAST RESORT. Disables certificate verification for
#                         every outbound request from the process, permanently,
#                         after the first TLS failure. Prefer pointing
#                         REQUESTS_CA_BUNDLE at your proxy's root CA instead —
#                         run.sh already does this automatically on macOS.
#
# Trading-desk model tiers (agents_desk.py). Both default to the model the rest
# of the backend uses; set FLINT_AGENTS_DEEP_MODEL to a stronger model to give
# the research manager and portfolio manager more room than the debaters.
#   FLINT_AGENTS_QUICK_MODEL=gemini-3.6-flash
#   FLINT_AGENTS_DEEP_MODEL=gemini-3.6-flash

# --- OmniRoute fallback (llm_router.py) -------------------------------------
# OmniRoute is an OpenAI-compatible local gateway that fans out across many
# providers: https://github.com/diegosouzapw/OmniRoute  (npm i -g omniroute)
#
# It is a STRICT FALLBACK. Gemini is always tried first; traffic only moves
# across after Gemini returns 429 / RESOURCE_EXHAUSTED, and only for as long as
# the retryDelay Gemini itself asked for. If OmniRoute is not running, the
# backend behaves exactly as it did before. Leave these unset for that default.
#
#   OMNIROUTE_ENABLED=0                            hard-disable the fallback
#   OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1   gateway endpoint
#   OMNIROUTE_API_KEY=                             from OmniRoute Dashboard > Endpoints
#   OMNIROUTE_MODEL=auto                           'auto' = OmniRoute picks a live provider
#   OMNIROUTE_TIMEOUT=180                          seconds per fallback call
