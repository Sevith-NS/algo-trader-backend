# Flint API configuration. Copy to .env and fill in. Never commit real values:
# .env, .env.clerk and every other .env* file is gitignored.

# --- Neon Postgres ----------------------------------------------------------
# Written by `neon link --project-id <id> --branch <branch>`. Local work uses
# the `dev` branch; production values are set on the deploy host only.
DATABASE_URL=                 # pooled, owner role (used by db.migrate for the host)
DATABASE_URL_UNPOOLED=        # direct, owner role: migrations only
# Written by `python -m db.migrate --app-role`. The API connects ONLY with this
# least-privilege role, which row-level security applies to.
DATABASE_URL_APP=

# --- Clerk ------------------------------------------------------------------
# Kept in .env.clerk via `clerk env pull --file .env.clerk`.
#   CLERK_PUBLISHABLE_KEY=    the token issuer is derived from it
#   CLERK_SECRET_KEY=         used only for account deletion (Clerk Backend API)
# Optional: verify tokens without a network call (PEM from the Clerk dashboard).
#   CLERK_JWT_KEY=
# Origins allowed to have minted a session token (the `azp` claim).
AUTHORIZED_PARTIES=http://localhost:3000
# Clerk user ids allowed to see operator diagnostics (comma-separated).
ADMIN_USER_IDS=

# --- Google Gemini ----------------------------------------------------------
# Powers the AI assistant, deep analysis and the multi-agent trading desk.
GEMINI_API_KEY=
#   FLINT_AGENTS_QUICK_MODEL=gemini-3.6-flash
#   FLINT_AGENTS_DEEP_MODEL=gemini-3.6-flash

# --- Optional runtime flags -------------------------------------------------
#   PORT=5000                  run.sh listen port (loopback only)
#   WEB_CONCURRENCY=N          worker count; rate-limit budgets are divided by it
#   MAX_CONTENT_LENGTH_BYTES=1048576
#   ALLOW_INSECURE_TLS=1       LAST RESORT: disables outbound certificate checks.
#                              Prefer REQUESTS_CA_BUNDLE pointing at your proxy CA.

# --- OmniRoute fallback (llm_router.py) -------------------------------------
# Strict fallback after Gemini returns 429. Leave unset to disable.
#   OMNIROUTE_ENABLED=0
#   OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
#   OMNIROUTE_API_KEY=
#   OMNIROUTE_MODEL=auto
#   OMNIROUTE_TIMEOUT=180

# --- Zerodha Kite Connect (read-only holdings) -----------------------------
# Redirect URL registered in the Kite developer console:
#   <frontend origin>/settings/brokers/callback
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# 32 random bytes, base64. Encrypts stored broker access tokens. Keep it stable:
# changing it makes stored tokens unreadable (users reconnect).
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BROKER_TOKEN_KEY=
